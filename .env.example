# Copy these names to the server environment file and replace the example values.
# Never put real usernames, passwords, or access keys in this file.

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# MySQL
MYSQL_DATABASE=waxing
DB_USERNAME=waxing_user
DB_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Used when the application runs outside Docker.
# Docker Compose creates its own URL using the values above.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/waxing?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul

# Initial administrator
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_long_unique_password

# Persistent uploads
APP_UPLOAD_DIR=/data/waxing/uploads

# Public reservation and social links
NAVER_RESERVATION_URL=https://example.com/naver
KAKAO_CHANNEL_URL=https://example.com/kakao
INSTAGRAM_URL=https://example.com/instagram
